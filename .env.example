# Copy this file to .env on the deploy host and fill in real values.
# Never commit the real .env — it stays on the deploy host only.

# HTTP port the server listens on inside the container.
PORT=3000

# SQLite database file path. When running via Docker Compose this should point
# inside the mounted data volume, e.g. /app/data/digest.sqlite.
DIGEST_DB_PATH=/app/data/digest.sqlite

# OpenAI-compatible LLM endpoint used for link enrichment (summary/topics/read_time).
# Leave all three blank to run with enrichment disabled (links stay unenriched).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Enrichment loop tuning (defaults shown; uncomment to override).
# ENRICHMENT_INTERVAL_MS=30000
# ENRICHMENT_CONCURRENCY=3
# ENRICHMENT_MAX_ATTEMPTS=5

# Logging.
# LOG_LEVEL=info
# LOG_RETENTION_DAYS=14
LOG_DIR=/app/data/logs
